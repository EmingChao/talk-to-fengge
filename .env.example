# ── LiveKit 配置 ──────────────────────────────
# LiveKit 本地开发服务器（livekit-server --dev 会自动使用这些默认值）
LIVEKIT_URL=ws://127.0.0.1:7880
# 浏览器可访问的 LiveKit 地址；生产环境应使用 wss:// 域名。
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
AGENT_NAME=talk-to-me-mimo

# Web 服务监听地址。容器内必须绑定 0.0.0.0。
WEB_HOST=0.0.0.0
WEB_PORT=8766

# 仅在服务器确实需要出口代理时填写，默认直连。
EGRESS_PROXY_URL=

# ── 人格配置 ─────────────────────────────────
# 当前仅支持 fengge（峰哥亡命天涯）
PERSONA_NAME=fengge
AGENT_INSTRUCTIONS=你是峰哥（峰哥亡命天涯）的AI分身。说话直白、辩证、有趣。像峰哥直播连线一样聊天。

# ── STT（语音识别）─────────────────────────────
# 推荐 cartesia（ink-whisper，免费层可用）；备选 deepgram / gemini
STT_PROVIDER=cartesia
CARTESIA_API_KEY=your-cartesia-api-key
CARTESIA_STT_MODEL=ink-whisper
CARTESIA_STT_LANGUAGE=zh

# Deepgram 备选（需付费）
# STT_PROVIDER=deepgram
# DEEPGRAM_API_KEY=your-deepgram-api-key
# DEEPGRAM_MODEL=nova-2
# DEEPGRAM_LANGUAGE=zh

# Gemini 备选（需 Google API Key）
# STT_PROVIDER=gemini
# GOOGLE_API_KEY=your-google-api-key
# STT_MODEL=gemini-2.5-flash

# ── LLM（大语言模型）─────────────────────────────
# 默认使用小米 MiMo Token Plan。tp- 密钥只能用于 Token Plan，不能用于 TTS。
LLM_PROVIDER=mimo
MIMO_LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_LLM_API_KEY=your-token-plan-api-key
MIMO_LLM_MODEL=mimo-v2.5
MIMO_LLM_MAX_TOKENS=2048

# MiniMax 备选
# LLM_PROVIDER=minimax
# MINIMAX_API_KEY=your-minimax-api-key
# MINIMAX_MODEL_NAME=MiniMax-M2.7-highspeed
# MINIMAX_MAX_TOKENS=300

# DeepSeek 备选
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_MODEL=deepseek-chat

# Gemini 备选
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=your-google-api-key
# LLM_MODEL=gemini-2.5-flash

# ── TTS（语音合成 + 音色克隆）────────────────────
# 默认使用 Fish Audio 流式 TTS。真实 API Key 只填写在本地或服务器环境文件中。
TTS_PROVIDER=fish_audio
FISH_AUDIO_API_KEY=replace-with-fish-audio-api-key
FISH_AUDIO_BASE_URL=https://api.fish.audio/v1
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_REFERENCE_ID=9344a2478df54929a786395f558b1267
FISH_AUDIO_SAMPLE_RATE=24000
FISH_AUDIO_LATENCY=balanced
FISH_AUDIO_CHUNK_LENGTH=300
FISH_AUDIO_MIN_CHUNK_LENGTH=50
FISH_AUDIO_SPEED=1.0
FISH_AUDIO_PROSODY_MODE=persona
FISH_AUDIO_PROSODY_INTENSITY=subtle

# 可选：切回小米 MiMo VoiceClone。这里必须使用按量 API 的 sk- 密钥。
# TTS_PROVIDER=mimo
# MIMO_TTS_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_TTS_API_KEY=your-pay-as-you-go-api-key
# MIMO_TTS_MODEL=mimo-v2.5-tts-voiceclone
# MIMO_TTS_VOICE_FILE=assets/voice_samples/fengge_ref.wav
# MIMO_TTS_STYLE_PROMPT=

# 方案 A：VoxCPM（开源模型，需 GPU 服务器或本地 GPU）
# TTS_PROVIDER=voxcpm
# VOXCPM_URL=http://localhost:8000
# VOXCPM_VOICE=fengge
# VOXCPM_SAMPLE_RATE=24000

# 方案 B：Cartesia Sonic（云端，需 Pro 订阅 $5/月 才能克隆音色）
# TTS_PROVIDER=cartesia
# CARTESIA_API_KEY=your-cartesia-api-key
# CARTESIA_VOICE_ID=your-cloned-voice-id
# CARTESIA_MODEL=sonic-3
# CARTESIA_LANGUAGE=zh
# CARTESIA_SPEED=0.8

# 方案 C：MiniMax TTS（云端）
# TTS_PROVIDER=minimax
# MINIMAX_API_KEY=your-minimax-api-key
# MINIMAX_VOICE_ID=your-voice-id
# MINIMAX_MODEL=speech-02-turbo

# ── OpenViking 记忆系统（可选）────────────────────
OPENVIKING_URL=http://127.0.0.1:1933
# OPENVIKING_DATA_DIR=./data/openviking/viking/default

# ── 调试 ──────────────────────────────────────
DEBUG=false
