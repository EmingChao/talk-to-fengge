# 复制为 .env 后填写。不要提交真实密钥。

# LiveKit 服务端
LIVEKIT_IMAGE=livekit/livekit-server:v1.9.0
LIVEKIT_API_KEY=replace-with-a-random-api-key
LIVEKIT_API_SECRET=replace-with-a-long-random-secret
LIVEKIT_NODE_IP=203.0.113.10
LIVEKIT_HTTP_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882

# 无域名时使用 ws://公网IP:7880；请将示例 IP 替换为服务器公网 IP。
LIVEKIT_PUBLIC_URL=ws://203.0.113.10:7880
WEB_PORT=8766

# Worker 固定配置
PERSONA_NAME=fengge
AGENT_NAME=talk-to-me-mimo
STT_PROVIDER=cartesia
LLM_PROVIDER=mimo
TTS_PROVIDER=mimo

# Cartesia STT
CARTESIA_API_KEY=replace-with-cartesia-api-key
CARTESIA_STT_MODEL=ink-whisper
CARTESIA_STT_LANGUAGE=zh

# MiMo LLM：使用 Token Plan 的 tp- 密钥
MIMO_LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_LLM_API_KEY=replace-with-token-plan-api-key
MIMO_LLM_MODEL=mimo-v2.5
MIMO_LLM_MAX_TOKENS=2048

# MiMo TTS：使用按量 API 的 sk- 密钥，不能与上面的 tp- 密钥混用
MIMO_TTS_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_API_KEY=replace-with-pay-as-you-go-api-key
MIMO_TTS_MODEL=mimo-v2.5-tts-voiceclone
MIMO_TTS_VOICE_FILE=assets/voice_samples/fengge_ref.wav
MIMO_TTS_STYLE_PROMPT=

# 可选配置
AGENT_INSTRUCTIONS=
OPENVIKING_URL=http://127.0.0.1:1933
EGRESS_PROXY_URL=
DEBUG=false
